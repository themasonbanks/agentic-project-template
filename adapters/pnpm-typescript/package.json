{
  "name": "agentic-typescript-adapter",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:unit && pnpm run build",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test:unit": "mkdir -p test-results coverage && node --test --experimental-test-coverage --test-reporter=junit --test-reporter-destination=test-results/unit.xml --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.mjs",
    "build": "tsc",
    "hooks:install": "lefthook install"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "lefthook": "2.2.2",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
